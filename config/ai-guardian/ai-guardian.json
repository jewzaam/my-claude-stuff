{
    "permissions": {
        "rules": [
            {
                "matcher": "mcp__*",
                "mode": "allow",
                "patterns": [
                    "*"
                ]
            }
        ]
    },
    "scan_pii": {
        "pii_types": [
            "ssn",
            "us_passport",
            "iban",
            "intl_phone",
            "address"
        ]
    },
    "ssrf_protection": {
        "allow_localhost": true
    },
    "daemon": {
        "mode": "local",
        "tray": {
            "enabled": true
        }
    }
}
