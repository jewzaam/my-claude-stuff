{
    "permissions": {
        "enabled": true,
        "rules": [
            {
                "matcher": "mcp__*",
                "mode": "allow",
                "patterns": [
                    "mcp__allowlist__get_allowed_permissions"
                ]
            },
            {
                "matcher": "Skill",
                "mode": "allow",
                "patterns": [
                    "*"
                ]
            }
        ]
    },
    "scan_pii": {
        "enabled": true,
        "pii_types": [
            "ssn",
            "us_passport",
            "iban"
        ],
        "action": "block",
        "ignore_files": [],
        "ignore_tools": [],
        "allowlist_patterns": []
    },
    "ssrf_protection": {
        "allow_localhost": true
    },
    "daemon": {
        "mode": "local",
        "tray": {
            "enabled": true
        }
    }
}
