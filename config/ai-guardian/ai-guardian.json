{
    "permissions": {
        "rules": [
            {
                "matcher": "mcp__*",
                "mode": "allow",
                "patterns": [
                    "*"
                ]
      },
      {
        "matcher": "Skill",
        "mode": "allow",
        "patterns": [
          "*"
        ]
            }
        ]
    },
    "scan_pii": {
        "pii_types": [
            "ssn",
            "us_passport",
            "iban",
            "intl_phone",
            "address"
    ],
    "action": "block"
    },
    "ssrf_protection": {
    "allow_localhost": true,
    "action": "block"
    },
    "daemon": {
        "mode": "local",
        "tray": {
            "enabled": true
        }
    },
    "security_instructions": {
        "inject_on_prompt": false
  },
  "mcp_server": {
    "proactive_level": "low"
  },
  "secret_scanning": {
    "execution_strategy": "first-match"
  },
  "directory_rules": {
    "action": "block"
  },
  "console": {
    "editor_theme": "monokai"
  },
  "on_scan_error": "allow",
  "secret_redaction": {
    "action": "warn"
  },
  "prompt_injection": {
    "action": "block"
  },
  "config_file_scanning": {
    "action": "block"
    }
}
