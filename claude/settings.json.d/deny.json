{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Grep(**/*.kdbx)",
      "Grep(**/.aws/**)",
      "Grep(**/.env)",
      "Grep(**/.ssh/**)",
      "Grep(**/.config/gws/**)",
      "Read(**/*.kdbx)",
      "Read(**/.aws/**)",
      "Read(**/.env)",
      "Read(**/.ssh/**)",
      "Read(**/.config/gws/**)"
    ]
  }
}
