{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "ai-guardian",
            "statusMessage": "🛡️ Scanning tool output...",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "ai-guardian",
            "statusMessage": "🛡️ Checking tool permissions...",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "ai-guardian",
            "statusMessage": "🛡️ Scanning prompt...",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}